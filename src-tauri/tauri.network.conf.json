{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "NetworkControl",
  "mainBinaryName": "network-control",
  "identifier": "io.github.cosxin.network-control",
  "bundle": {
    "publisher": "Cosxin",
    "longDescription": "Connect apps using the system proxy through your proxy servers, route individual apps and review connection history with the Mihomo core. Whole-device TUN and native firewall management require separately qualified helpers and remain unavailable in this build.",
    "shortDescription": "NetworkControl",
    "externalBin": ["sidecar/verge-mihomo"],
    "resources": ["resources/network-assets-*.json", "../LICENSE"],
    "createUpdaterArtifacts": false,
    "category": "Utility",
    "macOS": {
      "signingIdentity": null,
      "infoPlist": null,
      "exceptionDomain": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": []
    },
    "deep-link": {
      "desktop": {
        "schemes": ["networkcontrol"]
      }
    }
  }
}
